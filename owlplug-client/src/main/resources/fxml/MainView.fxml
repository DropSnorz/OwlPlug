<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.HeaderBar?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<?import com.owlplug.controls.Drawer?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<StackPane fx:id="rootPane" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.owlplug.core.controllers.MainController">
    <VBox AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"
          AnchorPane.topAnchor="0.0">
        <HeaderBar fx:id="headerBar" styleClass="header" prefHeight="45.0" VBox.vgrow="NEVER">
            <left>
                <TabPane fx:id="tabPaneHeader" prefHeight="45.0" prefWidth="500.0" style="-fx-tab-min-height: 36;">
                    <Tab text="Home" closable="false">
                        <graphic>
                            <ImageView fitHeight="20.0" fitWidth="20.0" preserveRatio="true" smooth="true">
                                <Image url="@../media/owlplug-logo-20.png"/>
                            </ImageView>
                        </graphic>
                    </Tab>
                    <Tab text="Plugins" closable="false">
                        <graphic>
                            <FontIcon iconLiteral="mdi2p-power-plug-outline" />
                        </graphic>
                    </Tab>
                    <Tab text="Explore" closable="false">
                        <graphic>
                            <FontIcon iconLiteral="mdi2c-compass-outline" />
                        </graphic>
                    </Tab>
                    <Tab text="Projects" closable="false">
                        <graphic>
                            <FontIcon iconLiteral="mdi2f-folder-music-outline" />
                        </graphic>
                    </Tab>
                    <Tab text="Settings" closable="false">
                        <graphic>
                            <FontIcon iconLiteral="mdi2c-cog-outline" />
                        </graphic>
                    </Tab>
                </TabPane>
            </left>
            <right>
                <HBox fx:id="headerControlsBox" alignment="CENTER_RIGHT" fillHeight="false" prefHeight="45.0" spacing="10.0">
                    <HBox fx:id="updatePane" alignment="CENTER_LEFT" prefHeight="45.0" spacing="5.0">
                        <padding>
                            <Insets left="10.0" right="10.0"/>
                        </padding>
                        <Label fx:id="updateLabel" text="New version available"/>
                        <Button fx:id="downloadUpdateButton" text="Download">
                            <graphic>
                                <FontIcon iconLiteral="mdi2d-download-outline"/>
                            </graphic>
                        </Button>
                    </HBox>
                </HBox>
            </right>
        </HeaderBar>
        <Drawer fx:id="leftDrawer" defaultDrawerSize="250" prefHeight="400.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
            <content>
                <BorderPane fx:id="mainPane" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308"
                            prefHeight="400.0" prefWidth="600.0">
                    <center>
                        <VBox fx:id="contentPanePlaceholder">
                            <TabPane fx:id="tabPaneContent" prefHeight="100.0" prefWidth="441.0"
                                     styleClass="no-header-tab-pane" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
                                <Tab closable="false" text="Home">
                                    <fx:include fx:id="homeView" source="HomeView.fxml"/>
                                </Tab>
                                <Tab closable="false" text="Plugins">
                                    <fx:include fx:id="pluginView" source="plugins/PluginsView.fxml"/>
                                </Tab>
                                <Tab closable="false" text="Explore">
                                    <fx:include fx:id="exploreView" source="explore/ExploreView.fxml"/>
                                </Tab>
                                <Tab closable="false" text="Projects">
                                    <fx:include fx:id="projectView" source="projects/ProjectsView.fxml"/>
                                </Tab>
                                <Tab closable="false" text="Settings">
                                    <fx:include fx:id="settingsView" source="SettingsView.fxml"/>
                                </Tab>
                            </TabPane>
                        </VBox>
                    </center>

                    <bottom>
                        <fx:include fx:id="taskBarView" source="TaskBarView.fxml"/>
                    </bottom>
                </BorderPane>
            </content>
        </Drawer>
    </VBox>
</StackPane>
