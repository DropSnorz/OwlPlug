<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.control.MenuItem?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<?import javafx.scene.control.SplitMenuButton?>
<BorderPane xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.owlplug.plugin.controllers.PluginsController">
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="40.0" spacing="5">
            <Button fx:id="newLinkButton" alignment="BASELINE_CENTER" text="New link">
                <graphic>
                    <FontIcon iconLiteral="mdi2f-folder-arrow-right" />
                </graphic>
            </Button>
            <TextField fx:id="searchTextField" prefHeight="27.0" prefWidth="170.0" promptText="Search"
                       HBox.hgrow="ALWAYS"/>
            <!--Fixed size pane to align search box, can be replaced by a V-grow property-->
            <Pane prefWidth="365.0" />
            <Button fx:id="exportButton" text="Export">
                <graphic>
                    <FontIcon iconLiteral="mdi2e-export" />
                </graphic>
            </Button>
            <HBox alignment="CENTER_LEFT">
                <SplitMenuButton fx:id="scanMenuButton" popupSide="LEFT" text="Scan" styleClass="accent">
                    <graphic>
                        <FontIcon iconLiteral="mdi2s-sync" />
                    </graphic>
                    <items>
                        <MenuItem fx:id="scanMenuItem" text="Scan" >
                            <graphic>
                                <FontIcon iconLiteral="mdi2s-sync" />
                            </graphic>
                        </MenuItem>
                        <MenuItem fx:id="fullScanMenuItem" text="Full Scan">
                            <graphic>
                                <FontIcon iconLiteral="mdi2s-sync-alert" />
                            </graphic>
                        </MenuItem>
                    </items>
                </SplitMenuButton>
            </HBox>
        </HBox>
    </top>
    <center>
      <BorderPane BorderPane.alignment="CENTER">
      	<center>
            <VBox fx:id="pluginsContainer">
            </VBox>
      	</center>
      	<left>
            <TabPane fx:id="displaySwitchTabPane" side="LEFT"
                     styleClass="floating" BorderPane.alignment="CENTER" tabMaxWidth="35">
                <Tab fx:id="displayListTab" closable="false">
                    <graphic>
                        <FontIcon iconLiteral="mdi2f-format-list-bulleted" />
                    </graphic>
                </Tab>
                <Tab fx:id="displayDirectoriesTab" closable="false">
                    <graphic>
                        <FontIcon iconLiteral="mdi2f-file-tree" />
                    </graphic>
                </Tab>
                <Tab fx:id="displayTableTab" closable="false">
                    <graphic>
                        <FontIcon iconLiteral="mdi2v-view-module-outline" />
                    </graphic>
                </Tab>
            </TabPane>
      	</left>
      </BorderPane>
   </center>
   <right>
       <VBox fx:id="pluginInfoPane" prefHeight="200.0" prefWidth="100.0" BorderPane.alignment="CENTER">
           <AnchorPane VBox.vgrow="ALWAYS">
               <fx:include source="NodeInfoView.fxml" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
                           AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0"/>
           </AnchorPane>
       </VBox>
   </right>
   <padding>
      <Insets bottom="10.0" left="5.0" right="5.0" top="2.0" />
   </padding>
   <bottom>
		<VBox minHeight="5.0" prefHeight="5.0" prefWidth="537.0" BorderPane.alignment="CENTER" />
   </bottom>
</BorderPane>
