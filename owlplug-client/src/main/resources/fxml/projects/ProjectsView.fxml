<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TreeView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<?import org.kordamp.ikonli.javafx.FontIcon?>
<BorderPane xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.owlplug.project.controllers.ProjectsController">
    <center>
        <BorderPane BorderPane.alignment="CENTER">
            <center>
                <HBox fx:id="filterContainer">
                    <TreeView fx:id="projectTreeView" prefHeight="215.0" prefWidth="521.0" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">

                    </TreeView>
                </HBox>
            </center>
            <left>
                <TabPane fx:id="projectTreeViewTabPane" side="LEFT"
                         styleClass="floating" BorderPane.alignment="CENTER" tabMaxWidth="35">
                    <Tab fx:id="treeTabAll" closable="false" >
                        <graphic>
                            <FontIcon iconLiteral="mdi2f-format-list-bulleted" />
                        </graphic>
                    </Tab>
                </TabPane>
            </left>
            <top>
                <HBox alignment="CENTER_LEFT" prefHeight="40.0" spacing="5">
                    <Button fx:id="filterToggleButton" onAction="#toggleFilter" accessibleText="Filter">
                        <graphic>
                            <FontIcon iconLiteral="mdi2f-filter-outline" />
                        </graphic>
                    </Button>
                    <Button fx:id="projectDirectoryButton" text="Project Directories">
                        <graphic>
                            <FontIcon iconLiteral="mdi2f-folder-multiple"/>
                        </graphic>
                    </Button>
                    <TextField fx:id="searchTextField" prefHeight="27.0" prefWidth="170.0" promptText="Search"
                               styleClass="label-dark" HBox.hgrow="ALWAYS"/>
                </HBox>
            </top>
        </BorderPane>
    </center>
    <right>
        <VBox prefHeight="200.0" prefWidth="100.0" BorderPane.alignment="CENTER">
            <HBox alignment="CENTER_RIGHT" minHeight="-Infinity" prefHeight="38.0" prefWidth="500.0"
                  VBox.vgrow="NEVER" spacing="5.0">
                <Button fx:id="syncProjectButton" text="Sync" defaultButton="true">
                    <graphic>
                        <FontIcon iconLiteral="mdi2s-sync" />
                    </graphic>
                </Button>
            </HBox>
            <AnchorPane VBox.vgrow="ALWAYS">
                <fx:include source="ProjectInfoView.fxml" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
                            AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0"/>
            </AnchorPane>
        </VBox>
    </right>
    <padding>
        <Insets bottom="10.0" left="5.0" right="5.0" top="2.0" />
    </padding>
    <bottom>
        <VBox minHeight="5.0" prefHeight="5.0" prefWidth="537.0" BorderPane.alignment="CENTER" />
    </bottom>
</BorderPane>
