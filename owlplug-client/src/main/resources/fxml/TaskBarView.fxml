<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.owlplug.core.controllers.TaskBarController"
      styleClass="task-bar-footer">

    <HBox alignment="CENTER_LEFT" spacing="6.0">
        <padding>
            <Insets bottom="6.0" left="16.0" right="6.0" top="6.0"/>
        </padding>
        <Label fx:id="taskLabel" styleClass="label-disabled" text="All clear"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="logsButton" contentDisplay="GRAPHIC_ONLY" styleClass="flat"
                accessibleText="Logs">
            <graphic><FontIcon iconLiteral="mdi2a-alert-circle-outline" iconSize="14"/></graphic>
            <tooltip><Tooltip text="Logs"/></tooltip>
        </Button>
        <Button fx:id="taskHistoryButton" contentDisplay="GRAPHIC_ONLY" styleClass="flat"
                accessibleText="Task History">
            <graphic><FontIcon iconLiteral="mdi2h-history" iconSize="14"/></graphic>
            <tooltip><Tooltip text="Task History"/></tooltip>
        </Button>
    </HBox>

    <ProgressBar fx:id="taskProgressBar" maxWidth="1.7976931348623157E308" prefHeight="3.0"
                 progress="0.0" styleClass="task-bar-progress"/>

</VBox>